rules_version = '2';

// Fittract account data lives at users/{uid}; food photos are separate
// documents under users/{uid}/foodImages so the account snapshot stays small.
//
// Access rules:
//   - Only the authenticated owner may read or write their document.
//   - Deletes are denied: data removal goes through a sanitized empty
//     snapshot, so nothing is silently destroyed from a client.
//   - Writes must keep the {data, updatedAt} shape and must never contain
//     password material or other denylisted keys inside data.
//
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt > 0
        // Never accept credential material or secrets from a client.
        && !request.resource.data.data.keys().hasAny([
             'cred', 'pw', 'password', 'hash', 'salt'
           ])
        // Loose size bound: keeps documents well under Firestore's 1 MiB
        // limit so a runaway list cannot brick the account.
        && request.resource.data.data.size() < 200;

      allow delete: if false;

      match /foodImages/{imageId} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
               'imageData', 'contentType', 'createdAt'
             ])
          && request.resource.data.imageData is string
          && request.resource.data.imageData.size() < 950000
          && request.resource.data.contentType is string
          && request.resource.data.contentType.matches('image/.*')
          && request.resource.data.createdAt is int
          && request.resource.data.createdAt > 0;

        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Any other path is denied by default (no matching rule).
  }
}
